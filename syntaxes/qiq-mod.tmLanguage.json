{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "qiq.mod",
  "scopeName": "source.qiq-mod",
  "patterns": [
    { "match": "//\\s*indirect\\s*$", "name": "comment.line.double-slash.indirect.qiq-mod" },
    { "match": "//.*$", "name": "comment.line.double-slash.qiq-mod" },
    { "match": "^\\s*(module|qiq|require|replace)\\b", "captures": { "1": { "name": "keyword.other.directive.qiq-mod" } } },
    { "match": "=>", "name": "keyword.operator.arrow.qiq-mod" },
    { "match": "\\bv[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\b", "name": "constant.numeric.version.qiq-mod" },
    { "match": "\\bh1:[A-Za-z0-9+/=]+", "name": "constant.other.hash.qiq-mod" },
    { "match": "(?<=^qiq\\s)\\s*[0-9]+\\.[0-9]+", "name": "constant.numeric.version.qiq-mod" },
    { "match": "(?:\\.\\.?/|/)[^\\s]*", "name": "string.unquoted.path.qiq-mod" },
    { "match": "[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)+|[A-Za-z0-9-]+\\.[A-Za-z0-9.-]+", "name": "entity.name.module.qiq-mod" },
    { "match": "[()]", "name": "punctuation.section.block.qiq-mod" }
  ]
}
