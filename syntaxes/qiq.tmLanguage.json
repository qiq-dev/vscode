{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "qiq",
  "scopeName": "source.qiq",
  "patterns": [
    { "include": "#comment" },
    { "include": "#import" },
    { "include": "#extern" },
    { "include": "#class-declaration" },
    { "include": "#function-declaration" },
    { "include": "#code" }
  ],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#regex-call" },
        { "include": "#fstring" },
        { "include": "#raw-string" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#number" },
        { "include": "#closure" },
        { "include": "#function-declaration" },
        { "include": "#function-type" },
        { "include": "#keyword" },
        { "include": "#new" },
        { "include": "#class-name" },
        { "include": "#static-access" },
        { "include": "#member" },
        { "include": "#named-argument" },
        { "include": "#call" },
        { "include": "#type" },
        { "include": "#operator" },
        { "include": "#punctuation" }
      ]
    },
    "comment": {
      "patterns": [
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.qiq"
        },
        {
          "comment": "/** ... */ before a declaration: shown in hovers.",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "name": "comment.block.documentation.qiq"
        },
        {
          "comment": "/* ... */, which may span lines and doesn't nest.",
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.qiq"
        }
      ]
    },
    "regex-call": {
      "comment": "A std/regex call whose pattern is a raw string: the pattern gets regex highlighting, and the rest of the call is ordinary code.",
      "begin": "\\b(preg_(?:match_all|match|test|replace_callback|replace|split))\\s*(\\()\\s*(?=`)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.call.qiq"
        },
        "2": {
          "name": "punctuation.qiq"
        }
      },
      "end": "(?<=`)",
      "patterns": [
        {
          "include": "#regex"
        }
      ]
    },
    "regex": {
      "comment": "A PHP-style pattern in a raw string: delimiter, expression, delimiter, flags.",
      "begin": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.qiq"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.qiq"
        }
      },
      "name": "string.regexp.qiq",
      "patterns": [
        {
          "match": "\\G\\s*([^\\w\\s\\\\`])",
          "captures": {
            "1": {
              "name": "punctuation.definition.delimiter.regexp.qiq"
            }
          }
        },
        {
          "match": "([^\\w\\s\\\\`])([imsxuUDAnJ]*)(?=`)",
          "captures": {
            "1": {
              "name": "punctuation.definition.delimiter.regexp.qiq"
            },
            "2": {
              "name": "keyword.other.flag.regexp.qiq"
            }
          }
        },
        {
          "include": "#regex-body"
        }
      ]
    },
    "regex-body": {
      "patterns": [
        {
          "match": "\\\\[dDwWsShHvVRNXC]|\\\\[pP]\\{\\^?[A-Za-z_&]+\\}|\\\\[pP][A-Za-z]",
          "name": "constant.other.character-class.escape.backslash.regexp.qiq"
        },
        {
          "match": "\\\\[bBAzZGK]",
          "name": "keyword.control.anchor.regexp.qiq"
        },
        {
          "match": "\\\\(?:[1-9][0-9]?|g\\{?-?[0-9]+\\}?|k<[A-Za-z_][A-Za-z0-9_]*>|k\\{[A-Za-z_][A-Za-z0-9_]*\\}|k'[A-Za-z_][A-Za-z0-9_]*')",
          "name": "keyword.other.back-reference.regexp.qiq"
        },
        {
          "match": "\\\\(?:x\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{1,2}|0[0-7]{0,2}|o\\{[0-7]+\\}|c.|.)",
          "name": "constant.character.escape.backslash.regexp.qiq"
        },
        {
          "begin": "(\\[)(\\^)?",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.character-class.regexp.qiq"
            },
            "2": {
              "name": "keyword.operator.negation.regexp.qiq"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.character-class.regexp.qiq"
            }
          },
          "name": "constant.other.character-class.set.regexp.qiq",
          "patterns": [
            {
              "match": "\\\\[dDwWsShHvVRNXC]|\\\\[pP]\\{\\^?[A-Za-z_&]+\\}|\\\\[pP][A-Za-z]",
              "name": "constant.other.character-class.escape.backslash.regexp.qiq"
            },
            {
              "match": "\\\\[bBAzZGK]",
              "name": "keyword.control.anchor.regexp.qiq"
            },
            {
              "match": "\\\\(?:[1-9][0-9]?|g\\{?-?[0-9]+\\}?|k<[A-Za-z_][A-Za-z0-9_]*>|k\\{[A-Za-z_][A-Za-z0-9_]*\\}|k'[A-Za-z_][A-Za-z0-9_]*')",
              "name": "keyword.other.back-reference.regexp.qiq"
            },
            {
              "match": "\\\\(?:x\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{1,2}|0[0-7]{0,2}|o\\{[0-7]+\\}|c.|.)",
              "name": "constant.character.escape.backslash.regexp.qiq"
            },
            {
              "match": "\\[:\\^?[a-z]+:\\]",
              "name": "constant.other.character-class.posix.regexp.qiq"
            },
            {
              "match": "(?:[^\\\\\\]`]|\\\\.)-(?:[^\\\\\\]`]|\\\\.)",
              "name": "constant.other.character-class.range.regexp.qiq"
            }
          ]
        },
        {
          "match": "(\\(\\?<)([A-Za-z_][A-Za-z0-9_]*)(>)|(\\(\\?P?<)([A-Za-z_][A-Za-z0-9_]*)(>)|(\\(\\?')([A-Za-z_][A-Za-z0-9_]*)(')",
          "captures": {
            "1": {
              "name": "punctuation.definition.group.regexp.qiq"
            },
            "2": {
              "name": "entity.name.tag.named-group.regexp.qiq"
            },
            "3": {
              "name": "punctuation.definition.group.regexp.qiq"
            },
            "4": {
              "name": "punctuation.definition.group.regexp.qiq"
            },
            "5": {
              "name": "entity.name.tag.named-group.regexp.qiq"
            },
            "6": {
              "name": "punctuation.definition.group.regexp.qiq"
            },
            "7": {
              "name": "punctuation.definition.group.regexp.qiq"
            },
            "8": {
              "name": "entity.name.tag.named-group.regexp.qiq"
            },
            "9": {
              "name": "punctuation.definition.group.regexp.qiq"
            }
          }
        },
        {
          "match": "\\(\\?(?:<=|<!|=|!)",
          "name": "punctuation.definition.group.assertion.regexp.qiq"
        },
        {
          "match": "\\(\\?(?:[imsxnUJ-]*:|>|\\||#[^)]*\\))?|\\(|\\)",
          "name": "punctuation.definition.group.regexp.qiq"
        },
        {
          "match": "(?:[*+?]|\\{[0-9]+(?:,[0-9]*)?\\})[?+]?",
          "name": "keyword.operator.quantifier.regexp.qiq"
        },
        {
          "match": "[\\^$]",
          "name": "keyword.control.anchor.regexp.qiq"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.or.regexp.qiq"
        },
        {
          "match": "\\.",
          "name": "constant.other.character-class.any.regexp.qiq"
        }
      ]
    },
    "fstring": {
      "comment": "f\"text {expression} text\": the expressions are code, with an optional :spec (as in sprintf); {{ and }} are braces.",
      "begin": "\\b(f)(\")",
      "beginCaptures": {
        "1": {
          "name": "storage.type.string.qiq"
        },
        "2": {
          "name": "punctuation.definition.string.begin.qiq"
        }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.qiq"
        }
      },
      "name": "string.quoted.double.interpolated.qiq",
      "patterns": [
        {
          "match": "\\{\\{|\\}\\}",
          "name": "constant.character.escape.qiq"
        },
        {
          "match": "\\\\[nrt\"\\\\]",
          "name": "constant.character.escape.qiq"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.qiq"
        },
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.qiq"
            }
          },
          "end": "(?:(?<!:)(:)(?!:)([-+ 0#.A-Za-z0-9]*))?(\\})",
          "endCaptures": {
            "1": {
              "name": "punctuation.separator.format.qiq"
            },
            "2": {
              "name": "constant.other.format-spec.qiq"
            },
            "3": {
              "name": "punctuation.section.interpolation.end.qiq"
            }
          },
          "name": "meta.embedded.interpolation.qiq",
          "contentName": "source.qiq",
          "patterns": [
            {
              "comment": "The ':' of `a ? b : c` isn't a format spec.",
              "begin": "\\?(?![?\\-])",
              "end": "(?<!:):(?!:)",
              "beginCaptures": {
                "0": {
                  "name": "keyword.operator.ternary.qiq"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "keyword.operator.ternary.qiq"
                }
              },
              "patterns": [
                {
                  "include": "#code"
                }
              ]
            },
            {
              "comment": "Braces inside the expression, such as a map literal.",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#code"
                }
              ]
            },
            {
              "include": "#code"
            }
          ]
        },
        {
          "match": "\\}",
          "name": "invalid.illegal.brace.qiq"
        }
      ]
    },
    "raw-string": {
      "comment": "`...`: no escapes, and it may span lines.",
      "begin": "`",
      "end": "`",
      "name": "string.quoted.other.raw.qiq"
    },
    "string": {
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.qiq" } },
      "end": "\"|$",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.qiq" } },
      "name": "string.quoted.double.qiq",
      "patterns": [
        { "match": "\\\\[nrt\"\\\\]", "name": "constant.character.escape.qiq" },
        { "match": "\\\\.", "name": "invalid.illegal.escape.qiq" }
      ]
    },
    "char": {
      "match": "'(?:\\\\[nrt'\"\\\\]|[^'\\\\])'",
      "name": "string.quoted.single.qiq",
      "captures": {}
    },
    "number": {
      "patterns": [
        { "match": "\\b[0-9]+\\.[0-9]+\\b", "name": "constant.numeric.float.qiq" },
        { "match": "\\b[0-9]+\\b", "name": "constant.numeric.integer.qiq" }
      ]
    },
    "import": {
      "comment": "import Name, Other as Alias from \"path\";  (import, from, and as are only keywords here)",
      "begin": "^\\s*(import)\\b(?=\\s+[A-Za-z_])",
      "beginCaptures": { "1": { "name": "keyword.control.import.qiq" } },
      "end": ";|$",
      "endCaptures": { "0": { "name": "punctuation.terminator.qiq" } },
      "name": "meta.import.qiq",
      "patterns": [
        { "include": "#comment" },
        { "match": "\\b(from|as)\\b", "name": "keyword.control.import.qiq" },
        { "include": "#string" },
        { "match": "\\b[A-Z][A-Za-z0-9_]*\\b", "name": "entity.name.type.qiq" },
        { "match": "\\b[a-z_][A-Za-z0-9_]*\\b", "name": "entity.name.function.qiq" },
        { "match": ",", "name": "punctuation.separator.comma.qiq" }
      ]
    },
    "extern": {
      "match": "^\\s*(extern)\\b",
      "captures": { "1": { "name": "storage.modifier.extern.qiq" } }
    },
    "class-declaration": {
      "match": "\\b(?:(abstract|final)\\s+)*(class|interface|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*:\\s*(int|string))?(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*))?(?:\\s+(implements)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*))?",
      "captures": {
        "1": { "name": "storage.modifier.qiq" },
        "2": { "name": "storage.type.class.qiq" },
        "3": { "name": "entity.name.type.class.qiq" },
        "4": { "name": "storage.type.primitive.qiq" },
        "5": { "name": "storage.modifier.extends.qiq" },
        "6": { "name": "entity.other.inherited-class.qiq" },
        "7": { "name": "storage.modifier.implements.qiq" },
        "8": { "name": "entity.other.inherited-class.qiq" }
      }
    },
    "function-declaration": {
      "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "storage.type.function.qiq" },
        "2": { "name": "entity.name.function.qiq" }
      }
    },
    "closure": {
      "comment": "An anonymous function: function(...) {...} or fn(...) => expr",
      "match": "\\b(fn)\\s*(?=\\()",
      "captures": { "1": { "name": "storage.type.function.arrow.qiq" } }
    },
    "function-type": {
      "match": "\\bfunction\\b(?=\\s*\\()",
      "name": "storage.type.function.qiq"
    },
    "keyword": {
      "patterns": [
        { "match": "\\b(if|else|foreach|while|switch|case|default|break|continue|return|try|catch|finally|throw|as)\\b", "name": "keyword.control.qiq" },
        { "match": "\\b(instanceof)\\b", "name": "keyword.operator.instanceof.qiq" },
        { "match": "\\b(public|private|protected|static|final|abstract|readonly)\\b", "name": "storage.modifier.qiq" },
        { "match": "\\b(const)\\b", "name": "storage.type.const.qiq" },
        { "match": "\\b(class|interface)\\b", "name": "storage.type.class.qiq" },
        { "match": "\\b(extends|implements)\\b", "name": "storage.modifier.qiq" },
        { "match": "\\b(true|false|null)\\b", "name": "constant.language.qiq" },
        { "match": "\\b(this)\\b", "name": "variable.language.this.qiq" },
        { "match": "\\b(self|parent|static)\\b(?=\\s*::)", "name": "variable.language.qiq" },
        { "match": "\\b(print|println)\\b", "name": "support.function.builtin.qiq" },
        { "match": "\\b(int|double|bool|byte|string|char|void|map)\\b", "name": "storage.type.primitive.qiq" }
      ]
    },
    "new": {
      "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.new.qiq" },
        "2": { "name": "entity.name.type.class.qiq" }
      }
    },
    "class-name": {
      "comment": "X::class, self::class, value::class: a class's name. A lowercase name before it is a variable.",
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*(class)\\b",
      "captures": {
        "1": { "patterns": [
          { "match": "\\b(self|parent|static|this)\\b", "name": "variable.language.qiq" },
          { "match": "\\b[A-Z][A-Za-z0-9_]*", "name": "entity.name.type.class.qiq" },
          { "match": ".+", "name": "variable.other.qiq" }
        ] },
        "2": { "name": "punctuation.separator.static.qiq" },
        "3": { "name": "keyword.other.class.qiq" }
      }
    },
    "static-access": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "patterns": [
          { "match": "\\b(self|parent|static)\\b", "name": "variable.language.qiq" },
          { "match": ".+", "name": "entity.name.type.class.qiq" }
        ] },
        "2": { "name": "punctuation.separator.static.qiq" },
        "3": { "name": "entity.name.function.member.qiq" }
      }
    },
    "member": {
      "patterns": [
        {
          "match": "(\\?->|->)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.arrow.qiq" },
            "2": { "name": "entity.name.function.member.qiq" }
          }
        },
        {
          "match": "(\\?->|->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.arrow.qiq" },
            "2": { "name": "variable.other.property.qiq" }
          }
        }
      ]
    },
    "named-argument": {
      "match": "(?<=[(,])\\s*([a-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
      "captures": {
        "1": { "name": "variable.parameter.named.qiq" },
        "2": { "name": "punctuation.separator.colon.qiq" }
      }
    },
    "call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.qiq" } }
    },
    "type": {
      "comment": "Class and interface names are capitalized by convention.",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.qiq"
    },
    "operator": {
      "patterns": [
        { "match": "=>", "name": "keyword.operator.arrow.qiq" },
        { "match": "\\?\\?", "name": "keyword.operator.null-coalescing.qiq" },
        { "match": "\\?(?![?\\-])", "name": "keyword.operator.ternary.qiq" },
        { "match": "\\+\\+|--", "name": "keyword.operator.increment.qiq" },
        { "match": "(?:<<|>>|[-+*/%&|^])=", "name": "keyword.operator.assignment.compound.qiq" },
        { "match": "==|!=|<=|>=|<(?!<)|>(?!>)", "name": "keyword.operator.comparison.qiq" },
        { "match": "&&|\\|\\||!", "name": "keyword.operator.logical.qiq" },
        { "match": "<<|>>|&|\\||\\^|~", "name": "keyword.operator.bitwise.qiq" },
        { "match": "\\*\\*|[-+*/%]", "name": "keyword.operator.arithmetic.qiq" },
        { "match": "=", "name": "keyword.operator.assignment.qiq" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "match": ";", "name": "punctuation.terminator.qiq" },
        { "match": ",", "name": "punctuation.separator.comma.qiq" },
        { "match": "::", "name": "punctuation.separator.static.qiq" },
        { "match": ":", "name": "punctuation.separator.colon.qiq" }
      ]
    }
  }
}
